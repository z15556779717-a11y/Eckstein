<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Supabase client configuration, expanded by the build from the
	     SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY build settings. CI supplies
	     them from the repository variables; a local build leaves them
	     undefined, which expands to an empty string and leaves the app
	     unconfigured rather than pointed at a placeholder host.

	     They are written as build-setting references rather than literals so
	     no real value is ever committed. `INFOPLIST_KEY_*` would be the
	     tidier spelling, but it only carries the keys Xcode's build-settings
	     spec enumerates, so an invented one is accepted by xcodebuild and
	     then dropped. That is how this file came to be written this way. -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>bluetooth-central</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Eckstein connects to your Xiaomi scale over Bluetooth so your weigh-ins are recorded without typing them in.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Eckstein connects to your Xiaomi scale over Bluetooth so your weigh-ins are recorded without typing them in.</string>
	<key>NSCameraUsageDescription</key>
	<string>Eckstein uses the camera to scan food barcodes, so you can log a meal without typing the product name.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Eckstein reads your weight, body fat, lean body mass and step count from Apple Health so your trends stay in one place.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Eckstein saves the weight, body fat and lean body mass readings you record to Apple Health.</string>
</dict>
</plist>
