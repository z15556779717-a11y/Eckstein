# Copy this to `.env` beside the Xcode project and fill in your own values.
#
# `.gitignore` excludes `.env` and everything matching `.env*`, so the copy you
# fill in is never committed -- only this template is. This file is read when
# Xcode launches the app, and by nothing on a real device: see
# `EnvironmentLoader` for the full list of sources and their precedence.
#
# The publishable key is public by design. It ships inside every copy of the
# app; row-level security is what protects the data. A `service_role` key or an
# `sb_secret_...` key must never appear here, and `AppEnvironment` refuses one
# if it somehow does.
#
# The values below are deliberately placeholders. `isSupabaseConfigured` treats
# anything containing "your-" as unconfigured, so a `.env` you forgot to edit
# leaves the app offline instead of pointing it at a host that does not exist.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The previous name for the same slot is still read, so an older `.env` keeps
# working. Prefer the name above in anything new.
# SUPABASE_ANON_KEY=your-legacy-anon-key
